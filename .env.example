# Required for contact and training form submissions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional email notifications: create a server API key at https://resend.com.
RESEND_API_KEY=re_your_api_key

# Use a sender address on a domain verified in Resend.
CONTACT_FROM_EMAIL=Frontline Firstaid <contact@your-verified-domain.org>

# Optional: override the shared password for the Instructor Resources page.
INSTRUCTOR_RESOURCES_PASSWORD=frontline25
